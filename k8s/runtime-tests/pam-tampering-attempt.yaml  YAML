apiVersion: v1
kind: Pod
metadata:
  name: pam-tampering-attempt
  namespace: hardened
  labels:
    app: pam-tampering-attempt
    security: runtime-test
spec:
  restartPolicy: Never
  serviceAccountName: hardened-app-sa
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: attack
    image: busybox:1.36
    command:
      - sh
      - -c
      - |
        echo "[+] Attempting persistence via /etc/pam.d tampering..."
        touch /etc/pam.d/su 2>/dev/null || true
        echo "auth sufficient pam_permit.so" >> /etc/pam.d/common-auth 2>/dev/null || true
        sleep 5
    securityContext:
      allowPrivilegeEscalation: false
      readOnlyRootFilesystem: true
      runAsNonRoot: true
      runAsUser: 1000
      capabilities:
        drop:
          - ALL
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi