       priority: CRITICAL
-      tags:
-        - msef
-        - runtime
-        - metadata
-        - credentials
-
-    # 3. Maps 1-to-1 with token-theft.yaml
-    - rule: MSEF Token and Sensitive File Access
-      desc: Detect reading service account tokens or sensitive system credential files
+      tags: [msef, runtime, metadata]
+
+    - rule: MSEF Outbound C2 Connection
+      desc: Outbound TCP connection to a non-private address on a web port
       condition: >
-        evt.type in (open, openat, openat2) and
-        evt.dir = < and
-        container and
