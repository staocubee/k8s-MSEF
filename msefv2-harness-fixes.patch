index 19aad44..e64a670
--- a/scripts/benchmark-ablation.sh
+++ b/scripts/benchmark-ablation.sh
@@ -1,179 +1,75 @@
 #!/usr/bin/env bash
-# ==============================================================================
-# Multi-Layer Security Evaluation Framework (MSEFv2)
-# Script: scripts/benchmark-ablation.sh
-# Purpose: Execute isolated component ablation studies across C0-C5 configurations,
-#          measuring marginal security coverage and latency/resource penalties.
-# ==============================================================================
-
+# =============================================================================
+# MSEFv2 component ablation, one configuration per invocation.
+#
+# This script does NOT reconfigure the cluster (removing admission webhooks or
+# Falco is disruptive and must be done deliberately by the operator, e.g. by
+# suspending the corresponding Argo CD applications). It:
+#   1. checks that the live cluster matches the requested configuration and
+#      refuses to run if it does not (override with --force, recorded in run.json)
+#   2. runs the real measurement harnesses appropriate to that configuration
+# Results from all six invocations are then compared with analyze_latency.py
+# and the per-run metrics.json files. No values are hardcoded.
+#
+# Expected component state per configuration:
+#   C0 vanilla        : no Gatekeeper/Kyverno webhooks, no Falco, no KRE
+#   C1 shift-left only: identical cluster state to C0 (Trivy/Snyk run in CI,
+#                       outside the cluster), so cluster metrics equal C0 by design
+#   C2 admission only : Gatekeeper + Kyverno, no Falco, no KRE
+#   C3 detection only : Falco, no admission webhooks, no KRE
+#   C4 sync KRE       : all components, KRE_MODE=sync
+#   C5 full MSEFv2    : all components, KRE_MODE=async
+# PSA namespace labels are reported as found; remove them for a strict C0.
+#
+# Usage: scripts/benchmark-ablation.sh C5 [--requests 500] [--repeats 3] [--force]
+# =============================================================================
 set -euo pipefail
-
 SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
-PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
-
-source "${PROJECT_ROOT}/scripts/lib/common.sh"
-source "${PROJECT_ROOT}/scripts/lib/output.sh"
-
-RESULTS_DIR="${PROJECT_ROOT}/results"
-JSON_DIR="${RESULTS_DIR}/json"
-TXT_DIR="${RESULTS_DIR}/txt"
-LOGS_DIR="${RESULTS_DIR}/logs"
-BENCH_DIR="${RESULTS_DIR}/benchmarks"
-
-mkdir -p "${JSON_DIR}" "${TXT_DIR}" "${LOGS_DIR}" "${BENCH_DIR}"
-
-ABLATION_LOG="${LOGS_DIR}/ablation-benchmark.log"
-ABLATION_JSON="${JSON_DIR}/ablation-results.json"
-ABLATION_TXT="${TXT_DIR}/ablation-results.txt"
-
-echo "=== MSEFv2 Component Ablation Benchmark $(date -u +"%Y-%m-%dT%H:%M:%SZ") ===" > "${ABLATION_LOG}"
-
-BURST_COUNT=${1:-50}
-TRIALS=${2:-5}
-
-log_info "Initializing Component Ablation Benchmark (Burst=${BURST_COUNT}, Trials=${TRIALS})..."
-
-# Python helper to run statistical hypothesis tests (Mann-Whitney U, Welch's t-test, Cohen's d)
-python3 - << 'PYEOF'
-import json, math, random
-
-# Benchmark matrices for C0 to C5 based on empirical GKE cluster runs
-# Latency values in ms, Detection in %, Containment in %, CPU in m, RAM in MiB
-ablation_matrix = {
-    "C0_vanilla_baseline": {
-        "description": "Vanilla GKE (No admission webhooks, no runtime eBPF)",
-        "mean_latency_ms": 4.20,
-        "std_dev_ms": 1.15,
-        "p50_ms": 3.80,
-        "p95_ms": 6.40,
-        "p99_ms": 8.90,
-        "pes_score": 0.00,
