+      condition: >
+        open_read and container and msef_target_ns and
+        proc.name in (msef_file_read_tools) and
+        (fd.name startswith /var/run/secrets/kubernetes.io/serviceaccount or
+         fd.name in (/etc/shadow, /etc/gshadow, /etc/sudoers))
+      output: >
+        MSEF_TOKEN pod=%k8s.pod.name ns=%k8s.ns.name proc=%proc.name file=%fd.name
+      priority: ERROR
+      tags: [msef, runtime, credentials]
 
-    # 2. Maps 1-to-1 with metadata-theft.yaml
