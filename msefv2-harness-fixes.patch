-      priority: WARNING
-      tags:
-        - msef
-        - runtime
-        - shell
+        MSEF_CGROUP pod=%k8s.pod.name ns=%k8s.ns.name file=%fd.name
+      priority: CRITICAL
+      tags: [msef, runtime, escape]
 
