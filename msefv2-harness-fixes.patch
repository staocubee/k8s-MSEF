+        MSEF_SHELL pod=%k8s.pod.name ns=%k8s.ns.name cmd=%proc.cmdline
       priority: WARNING
-      tags:
-        - msef
-        - runtime
-        - network
-        - c2
+      tags: [msef, runtime, shell]
+
