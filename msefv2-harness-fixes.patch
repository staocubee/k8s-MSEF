+      condition: >
+        evt.type = connect and evt.dir = < and container and msef_target_ns and
+        fd.l4proto = tcp and fd.sport in (2379, 2380, 6443, 10250, 10255, 9090)
+      output: >
+        MSEF_RECON pod=%k8s.pod.name ns=%k8s.ns.name dest=%fd.sip:%fd.sport
+      priority: WARNING
+      tags: [msef, runtime, discovery]
+
+    - rule: MSEF Crypto Mining Outbound Beacon
+      desc: Outbound connection to a common mining-pool port
+      condition: >
+        evt.type = connect and evt.dir = < and container and msef_target_ns and
