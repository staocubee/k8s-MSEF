+  # Plans: TERMINATE | QUARANTINE_TERMINATE | QUARANTINE_REVOKE_TERMINATE
+  rule-plans.json: |
+    {
+      "MSEF Interactive Shell Execution": "QUARANTINE_TERMINATE",
+      "MSEF Service Account Token Access": "QUARANTINE_REVOKE_TERMINATE",
+      "MSEF Cloud Metadata Server Access": "QUARANTINE_REVOKE_TERMINATE",
+      "MSEF Outbound C2 Connection": "QUARANTINE_TERMINATE",
+      "MSEF Host Filesystem Write Attempt": "TERMINATE",
+      "MSEF Cgroup Release Agent Write": "TERMINATE",
+      "MSEF Execution from tmp": "TERMINATE",
+      "MSEF PAM Configuration Modification": "TERMINATE",
+      "MSEF Network Recon Scan": "QUARANTINE_TERMINATE",
+      "MSEF Crypto Mining Outbound Beacon": "QUARANTINE_TERMINATE"
+    }
